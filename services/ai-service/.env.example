MODEL_BOUNDARY_BASE_URL=http://localhost:8081
MODEL_BOUNDARY_PATH=/api/model-boundary/v1
MODEL_BOUNDARY_TIMEOUT_SECONDS=90
MODEL_BOUNDARY_SERVICE_TOKEN=
# Signs Human Review close, AI-assistance and controlled-action forms with different HMAC purposes.
# Leave blank to disable those forms. Do not reuse MODEL_BOUNDARY_SERVICE_TOKEN. This is not a login secret.
HUMAN_REVIEW_FORM_SIGNING_SECRET=
# Configured host read by the development authenticator. Uvicorn does not use this value.
# Login also requires the accepted socket to be loopback, so --host 0.0.0.0 stays closed.
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8090
LLM_EXPERIMENTAL_ENABLED=false
FOLLOWUP_AGENT_ENABLED=false
# Authorized FHIR endpoint for Clinical Follow-up Review GET-only reads.
FHIR_BASE_URL=http://localhost:8080/fhir
# Dedicated Healthcare AI operational review store. File-backed SQLite; single ai-service instance in V1.
# Standard SQLite is not encrypted at rest. Use protected storage for any approved real-data environment.
AI_REVIEW_DB_PATH=./data/follow-up-review.sqlite3
# Separate SQLite file for human review sessions. Not the review database.
# The file alone is not a production identity control.
HUMAN_SESSION_DB_PATH=./data/human-session.sqlite3
# Development-only review login. Leave disabled. A true value also requires
# AI_SERVICE_HOST=127.0.0.1 or ::1, a Uvicorn listen address that is loopback,
# a distinct 32+ character secret, and a fixed principal.
# --host 0.0.0.0 keeps login disabled even if AI_SERVICE_HOST is loopback.
# When that guard is inactive, the review routes fail closed. It is not a production identity.
HUMAN_REVIEW_DEVELOPMENT_AUTH_ENABLED=false
HUMAN_REVIEW_DEVELOPMENT_AUTH_SECRET=
HUMAN_REVIEW_DEVELOPMENT_PRINCIPAL_ID=
HUMAN_REVIEW_DEVELOPMENT_PRINCIPAL_DISPLAY_NAME=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Separate SQLite index for synthetic institutional guidance. Not AI_REVIEW_DB_PATH.
INSTITUTIONAL_KNOWLEDGE_DB_PATH=./data/institutional-knowledge.sqlite3
# Embedding model only. Do not reuse GEMINI_MODEL. There is no silent fallback.
INSTITUTIONAL_KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
# Initial Demo Product V1 retrieval threshold from the first live embedding check.
# Provisional. Not clinical confidence and not a production calibration.
INSTITUTIONAL_KNOWLEDGE_MIN_SCORE=0.68
# Test-only opt-ins. HAPI tests do not enable live Gemini.
# RUN_LIVE_EMBEDDING_TESTS and RUN_LIVE_AI_ASSISTANCE_TESTS are separate from RUN_LIVE_GEMINI_TESTS.
RUN_HAPI_INTEGRATION_TESTS=false
RUN_LIVE_GEMINI_TESTS=false
RUN_LIVE_EMBEDDING_TESTS=false
RUN_LIVE_AI_ASSISTANCE_TESTS=false

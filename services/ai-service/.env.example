MODEL_BOUNDARY_BASE_URL=http://localhost:8081
MODEL_BOUNDARY_PATH=/api/model-boundary/v1
MODEL_BOUNDARY_TIMEOUT_SECONDS=90
MODEL_BOUNDARY_SERVICE_TOKEN=
# Signs Human Review close forms only. Leave blank to disable those forms.
# Do not reuse MODEL_BOUNDARY_SERVICE_TOKEN. This is not a login secret.
HUMAN_REVIEW_FORM_SIGNING_SECRET=
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8090
LLM_EXPERIMENTAL_ENABLED=false
FOLLOWUP_AGENT_ENABLED=false
# Authorized FHIR endpoint for Clinical Follow-up Review GET-only reads.
FHIR_BASE_URL=http://localhost:8080/fhir
# Dedicated Healthcare AI operational review store. File-backed SQLite; single ai-service instance in V1.
# Standard SQLite is not encrypted at rest. Use protected storage for any approved real-data environment.
AI_REVIEW_DB_PATH=./data/follow-up-review.sqlite3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Test-only opt-ins. HAPI tests do not enable live Gemini.
RUN_HAPI_INTEGRATION_TESTS=false
RUN_LIVE_GEMINI_TESTS=false

# Local lab defaults only. Copy to .env if you need to override them.
# Do not commit .env files.
HAPI_DB_NAME=hapi
HAPI_DB_USER=hapi
HAPI_DB_PASSWORD=hapi

# Synthetic OAuth 2.0 client credentials (Authorization Server + Java client).
# Keep these in the environment, not in versioned YAML.
LAB_OAUTH_CLIENT_SECRET=lab-secret
FHIR_SECURED_LAB_CLIENT_SECRET=lab-secret

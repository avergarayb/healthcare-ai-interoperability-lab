# Entrada privada. Docker publica estos puertos solo en 127.0.0.1.
# Dentro de la red, Caddy escucha en todas las interfaces para que el proxy
# de emisor alcance el mismo certificado de 127.0.0.1.
{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format json
		level INFO
	}
}

(private) {
	header {
		Strict-Transport-Security "max-age=3600"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

https://127.0.0.1:18543 {
	bind 127.0.0.1
	tls internal
	import private
	handle /realms/* {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host 127.0.0.1:18543
		}
	}
	handle /resources/* {
		reverse_proxy keycloak:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host 127.0.0.1:18543
		}
	}
	handle {
		respond "not_found" 404
	}
}

https://127.0.0.1:18445 {
	bind 127.0.0.1
	tls internal
	import private
	reverse_proxy mini-his:8095 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host 127.0.0.1:18445
	}
}

https://127.0.0.1:18444 {
	bind 127.0.0.1
	tls internal
	import private
	reverse_proxy mini-lis:8096 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host 127.0.0.1:18444
	}
}

https://127.0.0.1:18490 {
	bind 127.0.0.1
	tls internal
	import private
	reverse_proxy ai:8090 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host 127.0.0.1:18490
	}
}

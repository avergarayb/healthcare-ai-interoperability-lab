# Local Healthcare AI operational review store
/data/follow-up-review.sqlite3*
/services/ai-service/data/follow-up-review.sqlite3*

# Local institutional knowledge index. Not a review-case store.
/data/institutional-knowledge.sqlite3*
/services/ai-service/data/institutional-knowledge.sqlite3*

# Local human review session store. SHA-256 token hashes only. Not a review-case store.
/data/human-session.sqlite3*
/services/ai-service/data/human-session.sqlite3*

# Agent workflow checkpoints. Separate from Mini HIS and from Human Review.
/data/agent-workflow.sqlite3*
/services/ai-service/data/agent-workflow.sqlite3*

# Local Docker bind-mount data (named volumes are preferred)
infra/docker/data/

# Isolated end-to-end demo runtime. Contains loopback secrets and SQLite. Do not commit.
/services/ai-service/.tmp-e2e-demo/

# Oracle Health sandbox — never commit real values.
# Copy to `.env` at the repository root. `mvn spring-boot:run` loads it.
# Default tests do not load this file.

ORACLE_HEALTH_SANDBOX_ENABLED=false
ORACLE_HEALTH_SANDBOX_CLIENT_ID=
ORACLE_HEALTH_SANDBOX_BASE_URL=
ORACLE_HEALTH_SANDBOX_AUD=
ORACLE_HEALTH_SANDBOX_REDIRECT_URI=http://localhost:8081/smart/callback
ORACLE_HEALTH_SANDBOX_SCOPE=
# Standalone: do not include `launch` unless you also send a launch code (EHR launch).
# Condition search (Task 037) needs user/Condition.read in Code Console and here.
# Observation search (Task 038) needs user/Observation.read the same way.
# DiagnosticReport search (Task 039) needs user/DiagnosticReport.read the same way.
# MedicationRequest search (Task 040) needs user/MedicationRequest.read the same way.
# Clinical snapshot (Task 041) and controlled projection (Task 042) reuse those same resource scopes; they do not add new ones.
# Patient-only scopes often return HTTP 403.
ORACLE_HEALTH_SANDBOX_SMART_CONFIGURATION_URL=
# Controlled sandbox Patient context.
# Use only a sandbox Patient resource identifier.
# Never commit a real value.
ORACLE_HEALTH_SANDBOX_PATIENT_ID=

# Opt-in live IT only: mvn verify -Poracle-live
# ORACLE_HEALTH_LIVE_IT=true
# Browser login is manual. Do not commit tokens, codes, or verifiers.
